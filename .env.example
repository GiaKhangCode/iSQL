APP_NAME="iSQL API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://localhost:8000
SESSION_DRIVER=file

# ── MySQL (Nghiệp vụ) ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sql_uit
DB_USERNAME=root
DB_PASSWORD=

# ── SQL Server (Sandbox) ──
SQLSRV_HOST=your-server.database.windows.net
SQLSRV_PORT=1433
SQLSRV_DATABASE=sql_practice
SQLSRV_USERNAME=sa
SQLSRV_PASSWORD=YourSecurePassword123

# ── JWT / Sanctum ──
JWT_SECRET=your-super-secret-jwt-key
JWT_ALGO=HS256
JWT_TTL=1440

# ── Redis (Queue chấm bài) ──
QUEUE_CONNECTION=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Cấu hình Gửi Email (Google Mail SMTP để gửi OTP) ──
# Lưu ý: 
# 1. Để gửi qua Gmail thật, đặt MAIL_MAILER=smtp. Nếu chưa có mật khẩu ứng dụng, có thể tạm để MAIL_MAILER=log để mã OTP ghi vào file storage/logs/laravel.log.
# 2. MAIL_PASSWORD: Bạn PHẢI tạo Mật khẩu ứng dụng (App Password 16 chữ số) từ Google:
#    Vào https://myaccount.google.com/apppasswords -> Tạo mật khẩu ứng dụng -> Dán chuỗi 16 ký tự vào đây.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="iSQL Platform"
