{
  "name": "sql-practice-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc -b && vite build",
    "test:builder-settings": "node tests/builder-problem-settings.test.mjs && node tests/builder-settings-flow.test.mjs",
    "test:workspace-flow": "node tests/workspace-pane-tabs.test.mjs && node tests/workspace-navigation.test.mjs && node tests/workspace-flow.test.mjs && node tests/workspace-submit-flow.test.mjs",
    "test:database-views": "node tests/database-views.test.mjs",
    "test:database-setup": "node tests/database-setup-tabs.test.mjs",
    "test:stage-schema": "node tests/stage-schema-changes.test.mjs",
    "test:exam-mode": "node tests/exam-clipboard.test.mjs && node tests/exam-mode.test.mjs",
    "test:problem-library": "node tests/problem-library.test.mjs",
    "test:library-bundle": "node tests/library-bundle.test.mjs",
    "test:results-tabs": "node tests/results-tabs.test.mjs",
    "test:grading-roster": "node tests/grading-roster.test.mjs && node tests/exam-review-routing.test.mjs",
    "test:examinations": "node tests/examination-builder.test.mjs",
    "test:exam-admission": "node tests/exam-admission.test.mjs",
    "test:workspace": "node tests/workspace.test.mjs && node tests/workspace-parts.test.mjs",
    "test:sql-solution": "node tests/sql-solution.test.mjs",
    "test:dql-sales": "node tests/dql-sales-flow.test.mjs",
    "test:problem-reading": "node tests/problem-reading-sections.test.mjs",
    "test:teacher-review": "node tests/teacher-review.test.mjs",
    "test:trigger-authoring": "node tests/trigger-authoring.test.mjs",
    "test:question-workflow": "node tests/question-workflow.test.mjs",
    "test:submissions-history": "node tests/submissions-history.test.mjs",
    "test:toasts": "node tests/stacking-toasts.test.mjs",
    "test:tooltips": "node tests/gliding-tooltip.test.mjs",
    "test:rich-text": "node tests/rich-text-formatting.test.mjs && node tests/rich-text-editor.test.mjs",
    "test:i18n": "node tests/i18n.test.mjs",
    "test:language-client": "node tests/language-client.test.mjs",
    "test:theme-reveal": "node tests/theme-reveal.test.mjs",
    "test:language-motion": "node tests/language-motion.test.mjs",
    "test": "tsc --noEmit -p tsconfig.app.json && node tests/services.test.mjs && node tests/i18n.test.mjs && node tests/language-motion.test.mjs && node tests/theme-reveal.test.mjs && node tests/language-client.test.mjs"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/language": "^6.12.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.23.8",
    "apexcharts": "^8.8.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-apexcharts": "^2.2.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "sql-formatter": "^15.9.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
